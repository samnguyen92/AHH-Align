# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example
!openclaw/.env.example

# python / openclaw local runtime
openclaw/venv/
openclaw/venv312/
openclaw/__pycache__/
openclaw/*.pyc
openclaw/openclaw.log
openclaw/telegram_memory.json
public/generated-insights/
public/generated-clinics/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
