# Asian Health Hub — Environment Variables
# Copy file này thành .env.local và điền giá trị thật.
# Trên Vercel, thêm các biến này trong Project Settings > Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public read access for the Next.js website
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Alternative legacy name supported by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-side key. Keep secret. Required by debug/admin server paths and OpenClaw.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# Alternative name supported by the app:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket used by OpenClaw for generated images.
# Create this as a public bucket in Supabase Storage.
SUPABASE_STORAGE_BUCKET=generated-images

# Optional. Enables OpenClaw clinic enrichment from Google Places:
# rating, review snippets, Google Maps URL, location, hours, and place photos.
# Enable Places API (New) in Google Cloud before using this key.
# GOOGLE_PLACES_API_KEY=your-google-places-api-key

# OpenClaw AI Content/Data Engine
# OPENROUTER_API_KEY=sk-or-...

# Telegram bot runs outside Vercel; only needed where you run openclaw/telegram_bot.py
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USER_IDS=123456789
