# PostgreSQL Connection (local dev: localhost:5433, Docker container: db:5432)
DATABASE_URL=postgresql://postgres:ahh_secure_pass_2026@localhost:5433/asian_health_hub
GOOGLE_PLACES_API_KEY=

# OpenRouter API Key for Deepseek/Gemini image preview
OPENROUTER_API_KEY=
# Optional. Model used when you chat with OpenClaw through Telegram.
OPENCLAW_AGENT_MODEL=deepseek/deepseek-v4-flash
# Optional. Model used by the Telegram intent analyzer worker.
OPENCLAW_INTENT_MODEL=deepseek/deepseek-v4-flash

# Optional. Models used by the multi-agent research pipeline.
# Planner/selector/sub-link extractor use the faster planning model.
OPENCLAW_RESEARCH_PLANNER_MODEL=deepseek/deepseek-v4-flash
# Fact extractor/final editor use the deeper synthesis model.
OPENCLAW_RESEARCH_DEEP_MODEL=deepseek-v3.2:cloud
OPENCLAW_RESEARCH_TIMEOUT=60
OPENCLAW_RESEARCH_RETRIES=3
OPENCLAW_RESEARCH_TARGET_LINKS=12
OPENCLAW_RESEARCH_FACT_WORKERS=3
# Optional. Preferred web search provider for research/reference gathering.
# Get a key from Brave Search API, then set BRAVE_SEARCH_API_KEY.
OPENCLAW_USE_BRAVE_SEARCH=true
BRAVE_SEARCH_API_KEY=
# Optional. Keep disabled by default because duckduckgo_search can crash on some macOS runtimes.
OPENCLAW_USE_DDGS_API=false

# Optional. Enrich clinic profiles from healthcare directory pages after Google Places.
# Supported providers: zocdoc, healthgrades, webmd, vitals.
# Disabled by default to keep batch runs faster and source-controlled.
OPENCLAW_ENABLE_THIRD_PARTY_ENRICHMENT=false
OPENCLAW_THIRD_PARTY_PROVIDERS=zocdoc,healthgrades
OPENCLAW_THIRD_PARTY_PROFILE_MODEL=deepseek/deepseek-v4-flash

# Telegram bot bridge
# Create bot with @BotFather, then paste token here.
TELEGRAM_BOT_TOKEN=
# Optional but recommended. Comma-separated Telegram user ids allowed to run jobs.
# Get your id from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# User management (/users, /user_add, /user_role, /user_disable, ...) is OFF unless this is set.
# Comma-separated Telegram user ids allowed to manage accounts: a subset of the ids above, usually just you.
TELEGRAM_SUPERADMIN_IDS=
# Public address of the website. Used to build the one-time invite links sent by /user_add,
# e.g. https://yourdomain.com  (without it the bot sends only the path and you add the domain yourself).
OPENCLAW_SITE_URL=
# Optional. Max number of Telegram messages used for one finished job output.
TELEGRAM_MAX_JOB_OUTPUT_CHUNKS=12
# Optional. Max characters saved per chat as local Telegram memory.
OPENCLAW_MEMORY_MAX_CHARS=60000

# Text/extraction/blog model and image models (image: primary then fallback)
OPENCLAW_TEXT_MODEL=openai/gpt-6-luna
OPENCLAW_TEXT_FALLBACK_MODEL=deepseek/deepseek-v4-flash
OPENCLAW_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
OPENCLAW_IMAGE_FALLBACK_MODEL=google/gemini-3.1-flash-image

# --- Website edits as Pull Requests (/web_edit, /seo_setup, /web_merge, ...) ---------------------------------------
# Fine-grained personal access token limited to THIS repository only, with "Contents: read & write" and
# "Pull requests: read & write". Create it at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPOSITORY=samnguyen92/AHH-Align
# What happens on the server after a merge: manual (default: you run ./deploy_hostinger_vps.sh), webhook, or docker
# (docker needs docker-compose.deploy.yml and gives the bot root-equivalent rights).
OPENCLAW_DEPLOY_MODE=manual
DEPLOY_WEBHOOK_URL=

# --- Instant refresh of the live site after the bot edits/approves a clinic (optional) ---
# Put the SAME random value (16+ characters) in the repo-root .env.local too (the web container reads it there).
# Without it the live page still updates by itself within about an hour.
REVALIDATE_SECRET=

# --- Chat brain ---
# tools (default): the model calls tools (function calling). If the model/provider cannot, the bot falls back to json.
# json: the older single-JSON intent classifier only.
OPENCLAW_AGENT_MODE=tools
# Model used for tool calling (default: OPENCLAW_TEXT_MODEL). It must support function calling on OpenRouter.
OPENCLAW_AGENT_TOOL_MODEL=

# --- Photo review by a vision model (filters logos, text graphics, food, patients' faces, other businesses' signs) ---
# on (default) | off. It needs OPENROUTER_API_KEY. One request per clinic, photos shrunk to 512 px, answers cached.
OPENCLAW_VISION=on
# Must be a model that accepts images on OpenRouter. Empty = OPENCLAW_TEXT_MODEL. A small, cheap vision model is enough.
OPENCLAW_VISION_MODEL=
# Hard limit of photos reviewed per day (cost guard). Beyond it only the size/duplicate gates decide.
OPENCLAW_VISION_DAILY_IMAGES=400
# Photos sent per clinic in one request.
OPENCLAW_VISION_MAX_IMAGES=10

# --- Clinic content ---
# Rescan builds the clinic texts only from facts quoted from the clinic's own website (each quote is checked against the
# page text) and translates them to VI/KO/ZH. It uses OPENCLAW_TEXT_MODEL (and the fallback). Per rescan this is about
# 5 requests (facts, text, 3 translations). /clean_content only re-translates the texts it changes.
