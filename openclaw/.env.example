# Copy these values from the Next.js .env.local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=generated-images
GOOGLE_PLACES_API_KEY=

# OpenRouter API Key for Deepseek/Gemini image preview
OPENROUTER_API_KEY=
# Optional. Model used when you chat with OpenClaw through Telegram.
OPENCLAW_AGENT_MODEL=deepseek/deepseek-chat
# Optional. Model used by the Telegram intent analyzer worker.
OPENCLAW_INTENT_MODEL=deepseek/deepseek-v4-flash

# Optional. Models used by the multi-agent research pipeline.
# Planner/selector/sub-link extractor use the faster planning model.
OPENCLAW_RESEARCH_PLANNER_MODEL=deepseek/deepseek-chat
# Fact extractor/final editor use the deeper synthesis model.
OPENCLAW_RESEARCH_DEEP_MODEL=deepseek-v3.2:cloud
OPENCLAW_RESEARCH_TIMEOUT=60
OPENCLAW_RESEARCH_RETRIES=3
OPENCLAW_RESEARCH_TARGET_LINKS=12
OPENCLAW_RESEARCH_FACT_WORKERS=3
# Optional. Keep disabled by default because duckduckgo_search can crash on some macOS runtimes.
OPENCLAW_USE_DDGS_API=false

# Telegram bot bridge
# Create bot with @BotFather, then paste token here.
TELEGRAM_BOT_TOKEN=
# Optional but recommended. Comma-separated Telegram user ids allowed to run jobs.
# Get your id from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Optional. Max number of Telegram messages used for one finished job output.
TELEGRAM_MAX_JOB_OUTPUT_CHUNKS=12
# Optional. Max characters saved per chat as local Telegram memory.
OPENCLAW_MEMORY_MAX_CHARS=60000
